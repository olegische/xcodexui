{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "xcodex-runtime": ["../xcodex/codex-rs/wasm/ts/browser-runtime/dist/index.js"],
      "xcodex-runtime/config": ["../xcodex/codex-rs/wasm/ts/browser-runtime/dist/config.js"],
      "xcodex-runtime/storage": ["../xcodex/codex-rs/wasm/ts/browser-runtime/dist/storage.js"],
      "xcodex-runtime/types": ["../xcodex/codex-rs/wasm/ts/browser-runtime/dist/types.js"],
      "@browser-codex/wasm-browser-host": ["../xcodex/codex-rs/wasm/ts/browser-host/src/index.ts"],
      "@browser-codex/wasm-browser-host/*": ["../xcodex/codex-rs/wasm/ts/browser-host/src/*"],
      "@browser-codex/wasm-browser-codex-runtime": ["../xcodex/codex-rs/wasm/ts/browser-codex-runtime/src/index.ts"],
      "@browser-codex/wasm-browser-codex-runtime/*": ["../xcodex/codex-rs/wasm/ts/browser-codex-runtime/src/*"],
      "@browser-codex/wasm-model-transport": ["../xcodex/codex-rs/wasm/ts/model-transport/src/index.ts"],
      "@browser-codex/wasm-model-transport/*": ["../xcodex/codex-rs/wasm/ts/model-transport/src/*"],
      "@browser-codex/wasm-runtime-client": ["../xcodex/codex-rs/wasm/ts/runtime-client/src/index.ts"],
      "@browser-codex/wasm-runtime-client/*": ["../xcodex/codex-rs/wasm/ts/runtime-client/src/*"],
      "@browser-codex/wasm-runtime-core": ["../xcodex/codex-rs/wasm/ts/runtime-core/src/index.ts"],
      "@browser-codex/wasm-runtime-core/*": ["../xcodex/codex-rs/wasm/ts/runtime-core/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
