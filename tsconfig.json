{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "xcodex-runtime": ["public/pkg/current/xcodex-runtime.js"],
      "xcodex-runtime/config": ["public/pkg/current/xcodex-runtime.js"],
      "xcodex-runtime/workspace": ["public/pkg/current/xcodex-runtime.js"],
      "xcodex-runtime/types": ["public/pkg/current/xcodex.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
